# Source allowlist: historical account evidence, media and local credentials stay out of Git.
/*
!/.gitignore
!/*.md
!/package.json
!/package-lock.json
!/manifest.yml
!/tsconfig.json
!/vite.config.ts
!/vitest.config.ts
!/playwright*.config.ts
!/src/
!/tests/
!/fixtures/
!/scripts/
!/docs/
!/evals/
!/skills/
!/config/
/config/*
!/config/editions.example.json
!/config/judge-agent-prompt.md
!/static/
/static/*
!/static/lotzero-ui/
/static/lotzero-ui/*
!/static/lotzero-ui/src/
!/static/lotzero-ui/public/
!/static/lotzero-ui/index.html
**/node_modules/
**/.env*
!**/.env.example
**/*.local.json
**/evidence/
**/demo/
**/test-results/
**/playwright-report/
**/.forge/
*.log
!/.github/
